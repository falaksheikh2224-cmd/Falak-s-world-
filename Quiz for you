<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Raj.exe × Falak 💗</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 18px;

    background:
        radial-gradient(circle at 15% 10%, #4b1838 0%, transparent 35%),
        radial-gradient(circle at 90% 90%, #261b50 0%, transparent 40%),
        #090811;

    color: white;
    font-family: Arial, sans-serif;
}

.card {
    width: min(94vw, 560px);
    padding: 30px 23px;
    border-radius: 30px;

    background: rgba(20, 18, 30, 0.95);

    border: 1px solid rgba(255,255,255,0.1);

    box-shadow:
        0 30px 90px rgba(0,0,0,0.6);

    text-align: center;

    position: relative;
    overflow: hidden;

    animation: appear 0.6s ease;
}

@keyframes appear {

    from {
        opacity: 0;
        transform: translateY(15px) scale(0.97);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

}

.glow {
    position: absolute;

    width: 200px;
    height: 200px;

    background: rgba(255, 92, 166, 0.13);

    filter: blur(65px);

    border-radius: 50%;

    right: -80px;
    top: -70px;
}

.tag {
    font-family: monospace;

    font-size: 12px;

    color: #ff7eb6;

    letter-spacing: 1px;

    margin-bottom: 8px;
}

.logo {
    font-family: monospace;

    font-weight: bold;

    font-size: 18px;

    margin-bottom: 25px;

    color: #f3c6ff;
}

.heart {
    font-size: 50px;

    animation: float 2s ease-in-out infinite;
}

@keyframes float {

    50% {
        transform: translateY(-8px) rotate(2deg);
    }

}

h1 {

    font-size: clamp(32px, 9vw, 48px);

    margin: 12px 0;

}

h2 {

    font-size: 25px;

    line-height: 1.3;

    margin: 15px 0 22px;

}

p {

    color: #d8d1df;

    line-height: 1.6;

}

button {

    width: 100%;

    padding: 16px;

    margin: 7px 0;

    border-radius: 18px;

    border: 1px solid rgba(255,255,255,0.08);

    background: #1d1a29;

    color: white;

    font-size: 15px;

    font-weight: bold;

    cursor: pointer;

    transition: 0.2s;

}

button:hover {

    transform: translateY(-3px);

    background: #292434;

}

.primary {

    background:
        linear-gradient(
            135deg,
            #ff6fae,
            #a98cff
        );

    color: #160b16;

    border: none;

}

.code {

    background: #08080d;

    border: 1px solid #292332;

    border-radius: 17px;

    padding: 16px;

    margin: 20px 0;

    text-align: left;

    font-family: monospace;

    font-size: 12px;

    line-height: 1.7;

    color: #cfc6d6;

}

.pink {

    color: #ff7eb6;

}

.result {

    padding: 17px;

    border-radius: 17px;

    background: #191520;

    border: 1px solid rgba(255,255,255,0.08);

    margin: 17px 0;

}

.tiny {

    font-size: 12px;

    color: #85808d;

}

.progress {

    height: 5px;

    background: #292532;

    border-radius: 10px;

    margin-bottom: 25px;

}

.bar {

    height: 100%;

    background:
        linear-gradient(
            90deg,
            #ff70ae,
            #b99cff
        );

    border-radius: 10px;

    transition: 0.4s;

}

</style>

</head>

<body>

<div class="card" id="app"></div>

<script>

const app = document.getElementById("app");

let questionNumber = 0;

let score = 0;


/* QUESTIONS */

const questions = [

{
    question: "What does Raj secretly love the most? 👀",

    answers: [
        "His phone 📱",
        "Food 🍕",
        "Coding 💻",
        "Falak ❤️"
    ],

    responses: [
        "Okayyy... phone supremacy. 😭",
        "Honestly, understandable.",
        "Of course. Programmer detected. 💻",
        "Correct answer. We can continue. 😌"
    ]
},

{
    question: "Who is the prettiest girl in Raj's world? 🌷",

    answers: [
        "Alia Bhatt",
        "Shraddha Kapoor",
        "Falak 👀",
        "Nobody"
    ],

    responses: [
        "Nice try. 😭",
        "She's pretty... but that's not the answer.",
        "FINALLY. You have functioning eyes. 😌❤️",
        "Wrong. Extremely wrong."
    ]
},

{
    question: "Raj receives a message from Falak saying 'I miss you.' What does he actually do? 👀",

    answers: [
        "Replies normally",
        "Smiles at his phone",
        "Pretends to be busy",
        "Immediately replies"
    ],

    responses: [
        "Very suspiciously calm. 😭",
        "CAUGHT YOU. 😭❤️",
        "Raj.exe is trying to hide his feelings.",
        "Okay lover boy. We see you. 👀"
    ]
},

{
    question: "What is Raj's biggest weakness? 😭",

    answers: [
        "Low battery",
        "Good food",
        "Falak",
        "Being teased by Falak"
    ],

    responses: [
        "Technology strikes again.",
        "Honestly, same.",
        "Interesting answer... noted. 👀",
        "Oh so teasing actually works? Good to know. 😭"
    ]
},

{
    question: "If Falak says 'I need you right now', Raj would... ❤️",

    answers: [
        "Say 'okay'",
        "Ask what's wrong",
        "Come running",
        "Send a meme"
    ],

    responses: [
        "That's a little too calm. 😭",
        "Sweet. Very sweet. ❤️",
        "Okayyyy Mr. Romantic. 👀",
        "A MEME?? RAJ. 😭"
    ]
},

{
    question: "Be honest... how much do you love Falak? 👀",

    answers: [
        "A little",
        "Quite a lot",
        "More than I admit",
        "Classified information 🤐"
    ],

    responses: [
        "I'm choosing not to comment. 😭",
        "Acceptable answer. ❤️",
        "Ohhh, someone's confessing now.",
        "Classic Raj. Hiding behind classified information. 😭"
    ]
},

{
    question: "Final question: Who is the luckiest person here? 💗",

    answers: [
        "Raj",
        "Falak",
        "Both of us",
        "The quiz developer"
    ],

    responses: [
        "Interesting choice... 😌",
        "Obviously. You have Raj. ❤️",
        "Okay, that's actually cute.",
        "That would be me. 😭"
    ]
}

];


/* HOME */

function home() {

app.innerHTML = `

<div class="glow"></div>

<div class="tag">
// PRIVATE LOVE BUILD
</div>

<div class="logo">
raj.exe × falak.exe
</div>

<div class="heart">
💗
</div>

<h1>
Hey Raj.
</h1>

<p>
Welcome to my tiny little corner of the internet.
</p>

<div class="code">

<span class="pink">
if
</span>
(raj.isCute) {

<br>

&nbsp;&nbsp;falak.isSmiling = true;

<br>

}

<br>

<span class="pink">
// please don't debug my feelings
</span>

</div>

<button
class="primary"
onclick="startQuiz()">

Enter Falak's World →

</button>

<p class="tiny">
Warning: this quiz contains suspicious amounts of flirting. 👀
</p>

`;

}


/* START */

function startQuiz() {

questionNumber = 0;

score = 0;

showQuestion();

}


/* QUESTION */

function showQuestion() {

const q = questions[questionNumber];

const progress =
(questionNumber / questions.length) * 100;

app.innerHTML = `

<div class="progress">

<div
class="bar"
style="width:${progress}%">
</div>

</div>

<div class="tag">

QUESTION
${String(questionNumber + 1).padStart(2,"0")}

/

${questions.length}

</div>

<h2>

${q.question}

</h2>

${q.answers.map((answer,index) => `

<button
onclick="answerQuestion(${index})">

${answer}

</button>

`).join("")}

<p class="tiny">

Think carefully, Raj. 👀

</p>

`;

}


/* ANSWER */

function answerQuestion(index) {

const q = questions[questionNumber];

let goodAnswer = false;


/* romantic answers */

if (questionNumber === 0 && index === 3)
goodAnswer = true;

if (questionNumber === 1 && index === 2)
goodAnswer = true;

if (questionNumber === 2 &&
(index === 1 || index === 3))
goodAnswer = true;

if (questionNumber === 3 &&
(index === 2 || index === 3))
goodAnswer = true;

if (questionNumber === 4 && index === 2)
goodAnswer = true;

if (questionNumber === 5 &&
(index === 2 || index === 3))
goodAnswer = true;

if (questionNumber === 6 && index === 2)
goodAnswer = true;


if (goodAnswer)

score++;


app.innerHTML = `

<div class="heart">

${goodAnswer ? "💗" : "😭"}

</div>

<h2>

${q.responses[index]}

</h2>

<div class="result">

<span class="pink">

raj.exe

</span>

<br><br>

${goodAnswer
? "Romantic mode detected. ❤️"
: "Hmm... we need to talk. 😭"}

</div>

<button
class="primary"
onclick="${
questionNumber + 1 < questions.length
? "questionNumber++; showQuestion()"
: "finishQuiz()"
}">

${
questionNumber + 1 < questions.length
? "Continue →"
: "See your result →"
}

</button>

`;

}


/* FINAL */

function finishQuiz() {

app.innerHTML = `

<div class="heart">

🎉

</div>

<div class="tag">

// LOVE BUILD SUCCESSFUL

</div>

<h1>

Raj.exe 💗

</h1>

<p>

Congratulations.

You have officially survived
Falak's completely unnecessary
love quiz.

</p>

<div class="result">

<h2>

${score >= 6
? "Okay... you're VERY cute. ❤️"
: score >= 4
? "Not bad, Raj. Falak approves. 😌"
: "We need to have a serious conversation. 😭"}

</h2>

<p>

Score:

<b>
${score}
/
${questions.length}
</b>

</p>

</div>

<div class="code">

<span class="pink">
console.log
</span>

("Raj has been caught.");

<br><br>

<span class="pink">
status:
</span>

"Too cute to escape ❤️";

<br><br>

<span class="pink">
warning:
</span>

"Falak is still watching 👀";

</div>

<p>

<i>

Thank you for entering my little world. 🌷

</i>

</p>

<button
class="primary"
onclick="home()">

Run Again ↻

</button>

`;

}


/* START WEBSITE */

home();

</script>

</body>
</html>
